### Windows
# Windows thumbnail cache files
Thumbs.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

### JetBrains
# JetBrains IDE directory
.idea/

# CMake build directories
cmake-build-*/

# File-based project format
*.iws
*.iml

# IntelliJ build output
out/
.playwright-mcp

# Local working notes (superpowers specs/plans) — not part of the plugin
docs/

# Dev-only — @opencode-ai/plugin types + @types/node via local symlinks
node_modules/

# ristretto gate transient state
.ristretto/

# Build output (staged by `bun run build` → scripts/build-ristretto.mjs; never committed)
/ristretto/
